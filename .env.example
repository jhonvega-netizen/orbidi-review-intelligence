PORT=4173
MAX_REVIEWS_CAP=5000

# Gemini (clasificación de reseñas — obligatorio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CHUNK_SIZE=50
GEMINI_CONCURRENCY=4

# OpenAI (clasificador alternativo, opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# SerpAPI (scraping Google Maps, opcional)
SERPAPI_API_KEY=

# HubSpot (obligatorio para análisis de tickets)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_REVIEW_PIPELINE_LABEL=customer success
HUBSPOT_REVIEW_STAGE_LABEL=inbox
HUBSPOT_REVIEW_STAGE_ID=
HUBSPOT_REVIEW_CATEGORY_PROPERTY=categoria_del_ticket
HUBSPOT_REVIEW_CATEGORY_VALUE=Reseña
HUBSPOT_CONTACTING_STAGE_ID=
HUBSPOT_CONTACTING_STAGE_LABEL=intentando contactar
HUBSPOT_PLATFORM_VALUE_GMB=Google
HUBSPOT_PLATFORM_VALUE_TRUSTPILOT=Trustpilot
HUBSPOT_GESTION_COMMENT_FIELD=comentario_gestion

# Google Business Profile OAuth (opcional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GBP_ACCESS_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Zernio (obligatorio para respuestas GMB)
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Dev — cambiar a 0 en producción si GEMINI_API_KEY está configurada
ALLOW_LOCAL_CLASSIFIER=1
